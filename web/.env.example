# Copy to .env.production (or set in your CI) to point the static site at a
# signaling server on another origin. Leave unset to use wss://<same host>/ws.
# VITE_SIGNALING_URL=wss://signal.example.nl/ws

# Optional: your own STUN/TURN servers as JSON. Default: Google's public STUN.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.nl:3478","username":"u","credential":"p"}]
